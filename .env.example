# Copy to .env and fill in. NEVER commit real values. All variables are optional in development.
NODE_ENV=development
PORT=8787
# Public HTTPS URL of the site (required in production)
PUBLIC_URL=http://localhost:3000
# Comma-separated origins allowed to make state-changing requests (defaults to PUBLIC_URL)
ALLOWED_ORIGINS=
DATABASE_PATH=./data/apex.db
UPLOAD_DIR=./data/uploads
# Required in production: 32+ random chars, e.g. `openssl rand -hex 32`. Rotating it invalidates issued QR codes.
QR_SIGNING_SECRET=
# development: simulator (default). production: midtrans (required)
PAYMENT_PROVIDER=simulator
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Set true only when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
COOKIE_SECURE=
SESSION_TTL_HOURS=168
# Development only; refused in production
DEMO_MODE=true
# Demo/serverless only (32+ chars): signs session tokens so multiple instances accept each other's sessions
SESSION_SECRET=
